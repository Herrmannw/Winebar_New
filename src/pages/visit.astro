---
import { ArrowUpRight, Mail, MapPin, Phone } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { business } from "../data/business";
import heroWineBar from "../assets/images/hero-wine-bar.jpg";
---

<BaseLayout
  title="Visit"
  description="Visit DaVinci's Wine Lounge & Bottle Shop in Seabrook, Texas. Find our address, current hours, reservations, and contact information."
>
  <PageHero
    eyebrow="Visit DaVinci's"
    title="Come through the shop. Stay beyond the door."
    lede="Browse the bottles, settle into the lounge, and let curiosity choose what comes next."
    image={heroWineBar}
    alt="DaVinci's intimate wine lounge with bottles and warm ambient light"
    objectPosition="center 54%"
  >
    <div class="hero-actions">
      <a class="button button--cognac" href={business.phoneActions.reservation}>
        <Phone size={17} aria-hidden="true" /> Reserve
      </a>
    </div>
  </PageHero>

  <section class="visit-section section section--ivory page-shell" id="after-hero">
    <div class="visit-section__intro">
      <p class="eyebrow eyebrow--brass">Find your way here</p>
      <h2>Your next discovery<br /><em>starts in Seabrook.</em></h2>
    </div>

    <div class="visit-section__details">
      <div>
        <p class="detail-label">Visit</p>
        <a
          class="text-link"
          href={business.location.mapsHref}
          target="_blank"
          rel="noreferrer"
          aria-label={`Open directions to ${business.location.displayAddress} in Google Maps`}
        >
          <MapPin size={16} aria-hidden="true" />
          <span>
            {business.location.streetAddress}<br />
            {business.location.city}, {business.location.region} {business.location.postalCode}
          </span>
        </a>
      </div>

      <div>
        <p class="detail-label">Hours</p>
        <ul class="visit-hours">
          {business.hours.map((row) => (
            <li>
              <span>{row.days}</span>
              <span>{row.hours}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="detail-label">Reservations</p>
        <p>Call us to reserve your table or plan an evening with friends.</p>
        <a class="button button--cognac" href={business.phoneActions.reservation}>
          <Phone size={17} aria-hidden="true" /> Reserve by phone
        </a>
      </div>
    </div>
  </section>

  <section class="club-callout section page-shell" aria-labelledby="connect-heading">
    <p class="eyebrow">Connect</p>
    <h2 id="connect-heading">Questions, gatherings, and everything in between.</h2>
    <p>Reach out about your visit, a private event, or what is happening next at DaVinci's.</p>
    <a class="button button--ivory" href={business.contact.emailHref}>
      <Mail size={17} aria-hidden="true" /> Email us
    </a>
    <a class="text-link" href={business.phoneActions.privateEvents}>
      <Phone size={16} aria-hidden="true" /> Private Events · {business.contact.phone}
    </a>
    {business.socialLinks.map((social) => (
      <a class="text-link" href={social.href} target="_blank" rel="noreferrer">
        {social.label}: {social.handle} <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    ))}
  </section>
</BaseLayout>
