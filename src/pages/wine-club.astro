---
import { Image } from "astro:assets";
import { ArrowRight, Mail } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { business } from "../data/business";
import winePour from "../assets/images/wine-pour.jpg";
import societyWineShelves from "../assets/images/society-wine-shelves.jpg";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title="The Society"
  description="Join The Society at DaVinci's for curated monthly wines, members-only tastings, preferred pricing, and special experiences behind the door."
>
  <PageHero
    eyebrow="The Society"
    title="A little closer to the story."
    lede="A membership for curious drinkers who want first access to the bottles, people, and experiences that inspire us."
    image={winePour}
    alt="Red wine being poured into a clear glass against a dark background"
    objectPosition="center 48%"
  >
    <div class="hero-actions">
      <a class="button button--cognac" href={business.contact.societyHref}>
        <Mail size={17} aria-hidden="true" /> Email to join
      </a>
    </div>
  </PageHero>

  <section class="club-intro section section--ivory page-shell" id="after-hero">
    <div>
      <p class="eyebrow eyebrow--brass">For curious drinkers</p>
      <h2>The bottles we’re excited about.<br /><em>Shared first.</em></h2>
    </div>
    <p class="body-large">
      The Society brings you closer to DaVinci’s through thoughtful monthly selections, intimate tastings, and first invitations to what is happening beyond the door.
    </p>
  </section>

  <section class="club-benefits section section--emerald page-shell" aria-labelledby="benefits-title">
    <div class="club-benefits__heading">
      <p class="eyebrow eyebrow--brass">Society benefits</p>
      <h2 id="benefits-title">More to taste.<br /><em>More to discover.</em></h2>
    </div>
    <ul class="benefit-list">
      <li><h3>Two curated monthly wines</h3></li>
      <li><h3>Members-only tastings</h3></li>
      <li><h3>First access to limited bottles</h3></li>
      <li><h3>Member pricing</h3></li>
      <li><h3>Special experiences behind the door</h3></li>
    </ul>
  </section>

  <section class="editorial-split editorial-split--reverse section--ivory">
    <div class="editorial-split__image">
      <Image
        src={societyWineShelves}
        alt="Curated wine bottles arranged on warm wooden shelves in a boutique shop"
        widths={[640, 960, 1280]}
        sizes="(max-width: 980px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="editorial-split__copy">
      <p class="eyebrow eyebrow--brass">How it works</p>
      <h2>Simple by design. Personal by nature.</h2>
      <ol class="club-steps">
        <li><span>01</span><div><strong>Email to join</strong><p>Tell us you are interested and we will share current membership details.</p></div></li>
        <li><span>02</span><div><strong>Pick up & taste</strong><p>Collect your monthly wines and get to know each selection with our team.</p></div></li>
        <li><span>03</span><div><strong>Keep discovering</strong><p>Enjoy member access to the bottles and experiences we are most excited to share.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="club-callout section page-shell">
    <p class="eyebrow">Membership details</p>
    <h2>Ready to join The Society?</h2>
    <p>
      Email us for current membership details and let us know what you are curious to discover next.
    </p>
    <a class="button button--ivory" href={business.contact.societyHref}>
      <Mail size={17} aria-hidden="true" /> Email to join
    </a>
    <a class="text-link" href={withBase("/menu/#experiences")}>
      Explore experiences <ArrowRight size={16} aria-hidden="true" />
    </a>
  </section>
</BaseLayout>
