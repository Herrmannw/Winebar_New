---
import { Image } from "astro:assets";
import { ArrowRight, ArrowUpRight, Mail, Phone } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { business } from "../data/business";
import heroWineBar from "../assets/images/hero-wine-bar.jpg";
import winePour from "../assets/images/wine-pour.jpg";
import wineShelves from "../assets/images/wine-shelves.jpg";
import sommelier from "../assets/images/sommelier-wine-tasting.jpg";
import charcuterie from "../assets/images/charcuterie-board.jpg";
---

<BaseLayout
  title={business.name}
  description="Discover DaVinci's, an intimate Alameda wine lounge and boutique bottle shop with curated pours, guided tastings, gourmet bites, and welcoming hospitality."
>
  <PageHero
    eyebrow="Wine lounge · Bottle shop · Alameda"
    title="Wine worth slowing down for."
    lede="An intimate neighborhood lounge where thoughtful hospitality, boutique bottles, and delicious discoveries meet."
    image={heroWineBar}
    alt="An intimate wine bar lined with bottles and warm ambient light"
    variant="home"
    objectPosition="center 54%"
  >
    <div class="hero-actions">
      <a class="button button--cognac" href={business.phoneActions.reservation}>
        <Phone size={17} aria-hidden="true" /> Call to reserve
      </a>
      <a class="button button--outline-light" href="/menu/">Explore the wine list</a>
    </div>
  </PageHero>

  <section class="manifesto section section--emerald page-shell" id="after-hero">
    <div class="manifesto__inner">
      <p class="eyebrow eyebrow--brass">A new neighborhood ritual</p>
      <h2>Exceptional bottles.<br /><em>Zero pretension.</em></h2>
      <p>
        DaVinci's was created for curious drinkers and seasoned collectors alike. Every bottle is chosen for quality, value, and the story behind the winery—then shared with guidance that feels personal, never intimidating.
      </p>
      <div class="ornament" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="image-links" aria-label="Explore DaVinci's">
    <a class="image-link" href="/about/">
      <Image
        src={winePour}
        alt="Red wine being poured into a glass"
        widths={[640, 960, 1280]}
        sizes="(max-width: 700px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
      <div class="image-link__content">
        <p class="eyebrow">The DaVinci's approach</p>
        <h2>About us</h2>
        <span class="image-link__arrow" aria-hidden="true"><ArrowRight size={21} /></span>
      </div>
    </a>
    <a class="image-link" href="/menu/">
      <Image
        src={wineShelves}
        alt="A curated collection of wine bottles on wooden shelves"
        widths={[640, 960, 1280]}
        sizes="(max-width: 700px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
      <div class="image-link__content">
        <p class="eyebrow">By the glass & by the bottle</p>
        <h2>Wine & bites</h2>
        <span class="image-link__arrow" aria-hidden="true"><ArrowRight size={21} /></span>
      </div>
    </a>
  </section>

  <section class="editorial-split section--ivory">
    <div class="editorial-split__copy">
      <p class="eyebrow eyebrow--brass">Curated for curiosity</p>
      <h2>There is always more to taste.</h2>
      <p class="body-large">
        Start with a guided flight, ask for a recommendation, or tell us the last bottle you loved. Our team makes discovery easy with welcoming conversation and a point of view you can trust.
      </p>
      <a class="text-link" href="/about/">
        Our philosophy <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="editorial-split__image">
      <Image
        src={sommelier}
        alt="A sommelier presenting a bottle of wine to friends at a table"
        widths={[640, 960, 1280]}
        sizes="(max-width: 980px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
  </section>

  <section class="events-section section section--charcoal page-shell">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow eyebrow--brass">Happenings</p>
        <h2>Taste something<br /><em>unexpected.</em></h2>
      </div>
      <p>
        Guided flights, visiting makers, and first looks at new arrivals. Call us for this month's details and availability.
      </p>
    </div>

    <ol class="event-list">
      {business.events.map((event, index) => (
        <li>
          <span class="event-list__number">0{index + 1}</span>
          <div class="event-list__title">
            <p>{event.cadence} · {event.time}</p>
            <h3>{event.name}</h3>
          </div>
          <p class="event-list__description">{event.description}</p>
          <a href={business.contact.telHref} aria-label={`Call about ${event.name}`}>
            <ArrowUpRight size={22} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="editorial-split editorial-split--reverse section--ivory">
    <div class="editorial-split__image">
      <Image
        src={charcuterie}
        alt="A generous charcuterie board with artisan cheeses, fruit, and cured meats"
        widths={[640, 960, 1280]}
        sizes="(max-width: 980px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="editorial-split__copy">
      <p class="eyebrow eyebrow--brass">At the table</p>
      <h2>Small bites, made to linger over.</h2>
      <p class="body-large">
        Charcuterie, crostini, and gourmet plates are designed to meet the wine in your glass—and give everyone one more reason to stay for another pour.
      </p>
      <a class="text-link" href="/menu/#boards-and-bites">
        See the bites <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="club-band section page-shell">
    <div class="club-band__mark" aria-hidden="true">D</div>
    <div class="club-band__copy">
      <p class="eyebrow">The DaVinci's Wine Club</p>
      <h2>A better way to discover what you love.</h2>
      <p>
        Two thoughtful bottles each month, member tastings, retail savings, and first access to the wines and stories we cannot wait to share.
      </p>
    </div>
    <a class="button button--ivory" href="/wine-club/">Explore membership</a>
  </section>

  <section class="visit-section section section--ivory page-shell">
    <div class="visit-section__intro">
      <p class="eyebrow eyebrow--brass">Visit DaVinci's</p>
      <h2>Your neighborhood<br /><em>glass awaits.</em></h2>
    </div>

    <div class="visit-section__details">
      <div>
        <p class="detail-label">Find us</p>
        <a href={business.location.mapsHref} target="_blank" rel="noreferrer">
          {business.location.streetAddress}<br />
          {business.location.city}, {business.location.region} {business.location.postalCode}
        </a>
      </div>
      <div>
        <p class="detail-label">Hours</p>
        <ul class="visit-hours">
          {business.hours.map((row) => <li><span>{row.days}</span><span>{row.hours}</span></li>)}
        </ul>
      </div>
      <div>
        <p class="detail-label">Stay in the know</p>
        <p>Get tasting dates, new arrivals, and member-only news in your inbox.</p>
        <a class="text-link" href={business.contact.newsletterHref}>
          <Mail size={15} aria-hidden="true" /> Join the email list
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
