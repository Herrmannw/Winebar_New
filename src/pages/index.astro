---
import { Image } from "astro:assets";
import { ArrowRight } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { business } from "../data/business";
import heroWineBar from "../assets/images/hero-wine-bar.jpg";
import winePour from "../assets/images/wine-pour.jpg";
import wineShelves from "../assets/images/wine-shelves.jpg";
import sommelier from "../assets/images/sommelier-wine-tasting.jpg";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title={business.name}
  description="Discover DaVinci's, a curated bottle shop and hidden wine lounge where thoughtful hospitality, guided experiences, and gourmet provisions meet."
>
  <PageHero
    eyebrow="Wine lounge · Bottle shop"
    title="There’s more behind the bottle."
    lede="Curated wines up front. Something unexpected awaits beyond the door."
    image={heroWineBar}
    alt="An intimate wine lounge lined with bottles and warm ambient light"
    variant="home"
    objectPosition="center 54%"
  />

  <section class="manifesto section section--emerald page-shell" id="after-hero">
    <div class="manifesto__inner">
      <p class="eyebrow eyebrow--brass">The DaVinci’s experience</p>
      <h2>Curated up front.<br /><em>Unexpected beyond.</em></h2>
      <p>
        Begin in a thoughtful retail shop, then step through to an intimate lounge built around discovery, conversation, and the pleasure of finding something new.
      </p>
      <div class="ornament" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="image-links" aria-label="Explore DaVinci's">
    <a class="image-link" href={withBase("/menu/")}>
      <Image
        src={wineShelves}
        alt="A curated collection of wine bottles on wooden shelves"
        widths={[640, 960, 1280]}
        sizes="(max-width: 700px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
      <div class="image-link__content">
        <p class="eyebrow">Tastings · Classes · Gourmet provisions</p>
        <h2>Experiences</h2>
        <span class="image-link__arrow" aria-hidden="true"><ArrowRight size={21} /></span>
      </div>
    </a>
    <a class="image-link" href={withBase("/about/")}>
      <Image
        src={winePour}
        alt="Red wine being poured into a glass"
        widths={[640, 960, 1280]}
        sizes="(max-width: 700px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
      <div class="image-link__content">
        <p class="eyebrow">Retail shop · Hidden lounge</p>
        <h2>Our story</h2>
        <span class="image-link__arrow" aria-hidden="true"><ArrowRight size={21} /></span>
      </div>
    </a>
  </section>

  <section class="editorial-split section--ivory">
    <div class="editorial-split__copy">
      <p class="eyebrow eyebrow--brass">Wine discovery</p>
      <h2>FOLLOW YOUR CURIOSITY.</h2>
      <p class="body-large">
        Tell us what you love. Tell us what you had last night. Tell us what you want to discover next.
      </p>
      <a class="text-link" href={withBase("/about/")}>
        Discover our approach <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="editorial-split__image">
      <Image
        src={sommelier}
        alt="A wine host presenting a bottle to guests at a table"
        widths={[640, 960, 1280]}
        sizes="(max-width: 980px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
  </section>

  <section class="experiences-teaser section section--charcoal page-shell">
    <div>
      <p class="eyebrow eyebrow--brass">Experiences</p>
      <h2>Evenings worth<br /><em>discovering.</em></h2>
    </div>
    <div class="experiences-teaser__copy">
      <p class="body-large">Tastings, visiting winemakers, guided flights and evenings worth discovering.</p>
      <ul class="experience-tags" aria-label="Experience highlights">
        <li>Wine tastings</li>
        <li>Education</li>
        <li>Visiting winemakers</li>
        <li>Members’ events</li>
        <li>Special experiences</li>
      </ul>
      <a class="button button--ivory" href={withBase("/menu/")}>Explore experiences</a>
    </div>
  </section>

  <section class="club-band section page-shell">
    <div class="club-band__mark" aria-hidden="true">D</div>
    <div class="club-band__copy">
      <p class="eyebrow">The Society</p>
      <h2>More access. More discovery.</h2>
      <p>
        Two curated monthly wines, members-only tastings, first access to limited bottles, member pricing, and special experiences behind the door.
      </p>
    </div>
    <a class="button button--ivory" href={withBase("/wine-club/")}>Enter The Society</a>
  </section>
</BaseLayout>
