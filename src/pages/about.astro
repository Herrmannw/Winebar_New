---
import { ArrowRight } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import wineShelves from "../assets/images/wine-shelves.jpg";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title="Our Story"
  description="Discover DaVinci's: a curated retail wine shop, welcoming place to learn, source for gourmet provisions, and hidden lounge built for curiosity."
>
  <PageHero
    eyebrow="Our story"
    title="The shop is only the beginning."
    lede="Curated bottles, thoughtful provisions, and welcoming guidance lead to something unexpected beyond the door."
    image={wineShelves}
    alt="A warmly lit collection of wine bottles in a boutique shop"
    objectPosition="center 48%"
  />

  <section class="about-story section section--ivory page-shell" id="after-hero">
    <div class="about-story__heading">
      <p class="eyebrow eyebrow--brass">Retail shop → hidden lounge</p>
      <h2>Come curious.<br /><em>Leave with a story.</em></h2>
    </div>
    <div class="about-story__copy body-large">
      <p>
        DaVinci's begins as a neighborhood bottle shop, filled with wines and provisions chosen for character, quality, and the people behind them.
      </p>
      <p>
        Step beyond the retail space and discover an intimate lounge made for guided tastings, classes, conversation, and the pleasure of finding something new.
      </p>
    </div>
  </section>

  <section class="principles section section--ivory page-shell">
    <div class="principles__intro">
      <p class="eyebrow eyebrow--brass">The concept</p>
      <h2>Four ways to<br /><em>follow your curiosity.</em></h2>
    </div>
    <ol class="numbered-list">
      <li>
        <span>01</span>
        <div>
          <h3>Retail</h3>
          <p>Boutique wines and thoughtful accessories selected for quality, value, and character.</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <h3>Education &amp; Classes</h3>
          <p>Approachable tastings and guided classes that turn questions into confident discoveries.</p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <h3>Gourmet Provisions</h3>
          <p>Boards, bites, and pantry finds selected to bring more pleasure to every bottle and table.</p>
        </div>
      </li>
      <li>
        <span>04</span>
        <div>
          <h3>Beyond the Door</h3>
          <p>A hidden lounge for conversation, discovery, and evenings that feel a little unexpected.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="club-callout section page-shell">
    <p class="eyebrow">The rest is meant to be discovered</p>
    <h2>See what is waiting beyond the door.</h2>
    <p>Explore upcoming tastings, classes, and special gatherings—or plan your first visit to DaVinci's.</p>
    <a class="button button--ivory" href={withBase("/menu/")}>
      Explore experiences <ArrowRight size={17} aria-hidden="true" />
    </a>
    <a class="text-link" href={withBase("/visit/")}>
      Plan your visit <ArrowRight size={16} aria-hidden="true" />
    </a>
  </section>
</BaseLayout>
