---
import { Image } from "astro:assets";
import { ArrowRight, Mail, Phone } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { business } from "../data/business";
import coupleWine from "../assets/images/couple-wine.jpg";
import sommelier from "../assets/images/sommelier-wine-tasting.jpg";
import wineShelves from "../assets/images/wine-shelves.jpg";
import charcuterie from "../assets/images/charcuterie-board.jpg";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title="About"
  description="Meet DaVinci's: an approachable, education-led wine lounge and bottle shop created to make exceptional wine welcoming for everyone."
>
  <PageHero
    eyebrow="Our story"
    title="Wine without the intimidation."
    lede="We believe the best wine experience starts with curiosity, conversation, and the freedom to simply enjoy what you love."
    image={coupleWine}
    alt="A couple enjoying wine together in a warmly lit restaurant"
    objectPosition="center 48%"
  />

  <section class="about-story section section--ivory page-shell" id="after-hero">
    <div class="about-story__heading">
      <p class="eyebrow eyebrow--brass">Why DaVinci's</p>
      <h2>Approachable by design.<br /><em>Exceptional by selection.</em></h2>
    </div>
    <div class="about-story__copy body-large">
      <p>
        DaVinci's was created for people who love discovering great wine without the intimidation often associated with wine culture.
      </p>
      <p>
        Our mission is simple: make exceptional wines approachable while creating a warm, sophisticated environment where every guest feels welcome. Whether you're exploring your first flight or searching for a rare bottle, our team is here to help you find something you'll love.
      </p>
    </div>
  </section>

  <section class="editorial-split editorial-split--reverse section--emerald">
    <div class="editorial-split__image">
      <Image
        src={sommelier}
        alt="A sommelier sharing the story of a wine with guests"
        widths={[640, 960, 1280]}
        sizes="(max-width: 980px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="editorial-split__copy">
      <p class="eyebrow eyebrow--brass">Hospitality with a point of view</p>
      <h2>Guidance that meets you where you are.</h2>
      <p class="body-large">
        There are no wrong questions here. Tell us what you usually drink, what you're eating, or how adventurous you feel. We will translate the labels, share the story, and pour a path worth exploring.
      </p>
      <a class="text-link" href={withBase("/menu/")}>
        Explore the wine list <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="pull-quote page-shell">
    <blockquote>“The right bottle is not always the rarest. It is the one that makes the table come alive.”</blockquote>
    <footer>Our philosophy</footer>
  </section>

  <section class="principles section section--ivory page-shell">
    <div class="principles__intro">
      <p class="eyebrow eyebrow--brass">What guides us</p>
      <h2>Every detail,<br /><em>intentionally chosen.</em></h2>
    </div>
    <ol class="numbered-list">
      <li>
        <span>01</span>
        <div><h3>Story over status</h3><p>We seek bottles with a clear sense of place, thoughtful farming, and people worth knowing behind them.</p></div>
      </li>
      <li>
        <span>02</span>
        <div><h3>Hospitality over rules</h3><p>Your taste is personal. Our role is to listen, offer context, and make discovery feel effortless.</p></div>
      </li>
      <li>
        <span>03</span>
        <div><h3>Quality with value</h3><p>Every pour earns its place through character and pleasure—not simply a famous label or price tag.</p></div>
      </li>
    </ol>
  </section>

  <section class="editorial-split section--charcoal">
    <div class="editorial-split__copy">
      <p class="eyebrow eyebrow--brass">Lounge meets bottle shop</p>
      <h2>Enjoy it here. Take the story home.</h2>
      <p class="body-large">
        Settle in for a flight and a board, then browse the shelves for tonight's dinner or your growing cellar. Our boutique shop turns every visit into a chance to bring home a new favorite.
      </p>
      <a class="text-link" href={withBase("/menu/#featured-bottles")}>
        Browse featured bottles <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="editorial-split__image">
      <Image
        src={wineShelves}
        alt="Bottles displayed in a warm boutique wine shop"
        widths={[640, 960, 1280]}
        sizes="(max-width: 980px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
  </section>

  <section class="private-events section page-shell">
    <div class="private-events__image">
      <Image
        src={charcuterie}
        alt="An elegant charcuterie board ready for a gathering"
        widths={[640, 960, 1280]}
        sizes="(max-width: 820px) 100vw, 44vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="private-events__copy">
      <p class="eyebrow eyebrow--brass">Private events</p>
      <h2>A room made for memorable conversations.</h2>
      <p>
        Celebrate birthdays, client gatherings, anniversaries, and intimate milestones with a tailored selection of wine, generous boards, and attentive hosting.
      </p>
      <div class="private-events__actions">
        <a class="button button--cognac" href={business.phoneActions.privateEvents}>
          <Phone size={17} aria-hidden="true" /> Call about your event
        </a>
        <a class="text-link" href={business.contact.emailHref}>
          <Mail size={15} aria-hidden="true" /> Email an inquiry
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
