---
import { Facebook, Instagram } from "lucide-astro";
import type { SocialLink } from "../data/business";

interface Props {
  links: readonly SocialLink[];
  tone?: "light" | "dark";
}

const { links, tone = "dark" } = Astro.props;
---

<nav
  class:list={["social-icon-links", `social-icon-links--${tone}`]}
  aria-label="Social media"
>
  {links.map((social) => (
    <a
      href={social.href}
      target="_blank"
      rel="noreferrer"
      aria-label={`${social.label}: ${social.handle} (opens in a new tab)`}
      title={`${social.label}: ${social.handle}`}
    >
      {social.platform === "instagram"
        ? <Instagram size={20} stroke-width={1.6} aria-hidden="true" />
        : <Facebook size={20} stroke-width={1.6} aria-hidden="true" />}
    </a>
  ))}
</nav>
