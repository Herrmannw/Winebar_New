---
import { Menu as MenuIcon, Phone, X } from "lucide-astro";
import { business } from "../data/business";
import { stripBase, withBase } from "../utils/paths";
import UpdatesPanel from "./UpdatesPanel.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const currentRoute = stripBase(currentPath);

const isCurrent = (href: string) => currentRoute.startsWith(href);
---

<header class="site-header" data-site-header>
  <a class="wordmark" href={withBase("/")} aria-label={`${business.name} home`}>
    <span class="wordmark__name">{business.name}</span>
    <span class="wordmark__descriptor">{business.descriptor}</span>
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    <ul>
      {business.navigation.map((item) => (
        <li>
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <button
      class="button button--small button--outline-light updates-trigger updates-trigger--desktop"
      type="button"
      aria-haspopup="dialog"
      aria-controls="updates-panel"
      aria-expanded="false"
      data-updates-open
    >
      STAY IN THE KNOW
    </button>
    <a class="button button--small button--cognac" href={business.phoneActions.reservation}>
      <Phone size={15} aria-hidden="true" />
      Reserve
    </a>
  </nav>

  <button
    class="menu-toggle"
    type="button"
    aria-label="Open navigation"
    aria-controls="mobile-navigation"
    aria-expanded="false"
    data-menu-open
  >
    <MenuIcon size={26} stroke-width={1.4} aria-hidden="true" />
  </button>

  <dialog class="mobile-menu" id="mobile-navigation" aria-label="Site navigation">
    <div class="mobile-menu__top">
      <a class="wordmark" href={withBase("/")} aria-label={`${business.name} home`}>
        <span class="wordmark__name">{business.name}</span>
        <span class="wordmark__descriptor">{business.descriptor}</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Close navigation" data-menu-close>
        <X size={28} stroke-width={1.3} aria-hidden="true" />
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Mobile navigation">
      <p class="eyebrow">Explore DaVinci's</p>
      <ul>
        {business.navigation.map((item, index) => (
          <li>
            <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
              <span class="mobile-menu__index">0{index + 1}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu__footer">
      <button
        class="button button--wide button--outline-light"
        type="button"
        aria-haspopup="dialog"
        aria-controls="updates-panel"
        aria-expanded="false"
        data-updates-open
      >
        STAY IN THE KNOW
      </button>
      <a class="button button--wide button--cognac" href={business.phoneActions.reservation}>
        <Phone size={17} aria-hidden="true" />
        Reserve
      </a>
    </div>
  </dialog>

  <noscript>
    <nav class="nojs-nav" aria-label="Navigation without JavaScript">
      {business.navigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      <a href={business.contact.newsletterHref}>STAY IN THE KNOW</a>
    </nav>
  </noscript>

  <UpdatesPanel
    recipient={business.contact.email}
    fallbackHref={business.contact.newsletterHref}
    reservationHref={business.phoneActions.reservation}
  />
</header>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const mobileMenu = document.querySelector<HTMLDialogElement>("#mobile-navigation");

  openButton?.addEventListener("click", () => {
    mobileMenu?.showModal();
    openButton.setAttribute("aria-expanded", "true");
    document.documentElement.classList.add("menu-is-open");
  });

  const closeMenu = () => mobileMenu?.close();
  closeButton?.addEventListener("click", closeMenu);

  mobileMenu?.addEventListener("close", () => {
    openButton?.setAttribute("aria-expanded", "false");
    document.documentElement.classList.remove("menu-is-open");
  });
</script>
