---
import { Menu as MenuIcon, Phone, X } from "lucide-astro";
import { business } from "../data/business";
import { stripBase, withBase } from "../utils/paths";
import BrandLogo from "./BrandLogo.astro";
import UpdatesPanel from "./UpdatesPanel.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const currentRoute = stripBase(currentPath);

const isCurrent = (href: string) => currentRoute.startsWith(href);
---

<header class="site-header" data-site-header>
  <a class="wordmark" href={withBase("/")} aria-label={`${business.name} home`}>
    <BrandLogo class="wordmark__logo" />
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    <ul>
      {business.navigation.map((item) => (
        <li>
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <button
      class="button button--small button--outline-light updates-trigger updates-trigger--desktop"
      type="button"
      aria-haspopup="dialog"
      aria-controls="updates-panel"
      aria-expanded="false"
      data-updates-open
    >
      STAY IN THE KNOW
    </button>
    <button
      class="button button--small button--cognac reserve-reveal"
      type="button"
      aria-label={`Reservation phone number ${business.contact.phone}. Activate to reveal.`}
      aria-pressed="false"
      data-phone-number={business.contact.phone}
      data-phone-reveal
    >
      <Phone size={15} aria-hidden="true" />
      <span class="reserve-reveal__text" aria-hidden="true">
        <span class="reserve-reveal__label">Reserve</span>
        <span class="reserve-reveal__number">{business.contact.phone}</span>
      </span>
    </button>
  </nav>

  <button
    class="menu-toggle"
    type="button"
    aria-label="Open navigation"
    aria-controls="mobile-navigation"
    aria-expanded="false"
    data-menu-open
  >
    <MenuIcon size={26} stroke-width={1.4} aria-hidden="true" />
  </button>

  <dialog class="mobile-menu" id="mobile-navigation" aria-label="Site navigation">
    <div class="mobile-menu__top">
      <a class="wordmark" href={withBase("/")} aria-label={`${business.name} home`}>
        <BrandLogo class="wordmark__logo" />
      </a>
      <button class="menu-toggle" type="button" aria-label="Close navigation" data-menu-close>
        <X size={28} stroke-width={1.3} aria-hidden="true" />
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Mobile navigation">
      <p class="eyebrow">Explore DaVinci's</p>
      <ul>
        {business.navigation.map((item, index) => (
          <li>
            <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
              <span class="mobile-menu__index">0{index + 1}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu__footer">
      <button
        class="button button--wide button--outline-light"
        type="button"
        aria-haspopup="dialog"
        aria-controls="updates-panel"
        aria-expanded="false"
        data-updates-open
      >
        STAY IN THE KNOW
      </button>
      <button
        class="button button--wide button--cognac reserve-reveal"
        type="button"
        aria-label={`Reservation phone number ${business.contact.phone}. Activate to reveal.`}
        aria-pressed="false"
        data-phone-number={business.contact.phone}
        data-phone-reveal
      >
        <Phone size={17} aria-hidden="true" />
        <span class="reserve-reveal__text" aria-hidden="true">
          <span class="reserve-reveal__label">Reserve</span>
          <span class="reserve-reveal__number">{business.contact.phone}</span>
        </span>
      </button>
    </div>
  </dialog>

  <noscript>
    <nav class="nojs-nav" aria-label="Navigation without JavaScript">
      {business.navigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>

    <div class="nojs-updates">
      {business.subscription.isConfigured ? (
        <form action={business.subscription.endpoint} method="POST">
          <label for="nojs-updates-email">Stay in the know</label>
          <div class="nojs-updates__row">
            <input
              id="nojs-updates-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="Email address"
              required
            />
            <button type="submit">Subscribe</button>
          </div>
          <input type="hidden" name="_subject" value="DaVinci's website updates request" />
          <input type="hidden" name="source" value="Website no-JavaScript form" />
          <div class="nojs-updates__honeypot" aria-hidden="true">
            <label for="nojs-updates-company">Leave this field empty</label>
            <input
              id="nojs-updates-company"
              name="_gotcha"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
        </form>
      ) : (
        <p>
          Email updates are temporarily unavailable. <a href={business.contact.emailHref}>Email us</a>{" "}
          to stay in touch.
        </p>
      )}
    </div>
  </noscript>

  <UpdatesPanel
    endpoint={business.subscription.endpoint}
    configured={business.subscription.isConfigured}
    reservationHref={business.phoneActions.reservation}
  />
</header>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const mobileMenu = document.querySelector<HTMLDialogElement>("#mobile-navigation");
  const phoneRevealButtons = document.querySelectorAll<HTMLButtonElement>("[data-phone-reveal]");

  openButton?.addEventListener("click", () => {
    mobileMenu?.showModal();
    openButton.setAttribute("aria-expanded", "true");
    document.documentElement.classList.add("menu-is-open");
  });

  const closeMenu = () => mobileMenu?.close();
  closeButton?.addEventListener("click", closeMenu);

  mobileMenu?.addEventListener("close", () => {
    openButton?.setAttribute("aria-expanded", "false");
    document.documentElement.classList.remove("menu-is-open");
  });

  phoneRevealButtons.forEach((button) => {
    const phoneNumber = button.dataset.phoneNumber ?? "";

    const setRevealed = (revealed: boolean) => {
      button.setAttribute("aria-pressed", String(revealed));
      button.setAttribute(
        "aria-label",
        revealed
          ? `Reservation phone number ${phoneNumber}. Activate to hide.`
          : `Reservation phone number ${phoneNumber}. Activate to reveal.`,
      );
    };

    button.addEventListener("click", () => {
      setRevealed(button.getAttribute("aria-pressed") !== "true");
    });

    button.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setRevealed(false);
    });
  });
</script>
