---
import { ArrowUpRight, Facebook, Instagram, Mail, Phone } from "lucide-astro";
import { business } from "../data/business";
import { withBase } from "../utils/paths";
import BrandLogo from "./BrandLogo.astro";
---

<footer class="site-footer">
  <div class="site-footer__grid page-shell">
    <div class="site-footer__brand">
      <a class="wordmark wordmark--footer" href={withBase("/")} aria-label={`${business.name} home`}>
        <BrandLogo class="wordmark__logo" loading="lazy" />
      </a>
      <p>{business.shortDescription}</p>
    </div>

    <div>
      <p class="footer-label">Explore</p>
      <nav class="footer-links" aria-label="Footer navigation">
        {business.navigation.map((item) => (
          <a class="footer-link" href={withBase(item.href)}>{item.label}</a>
        ))}
      </nav>
    </div>

    <div>
      <p class="footer-label">Connect</p>
      <div class="footer-links">
        <a class="footer-link" href={business.contact.emailHref}>
          <Mail size={16} aria-hidden="true" /> Email us
        </a>
        <a class="footer-link" href={business.phoneActions.privateEvents}>
          <Phone size={16} aria-hidden="true" /> Private Events
        </a>
        {business.socialLinks.map((social) => (
          <a class="footer-link" href={social.href} target="_blank" rel="noreferrer">
            {social.platform === "instagram"
              ? <Instagram size={16} aria-hidden="true" />
              : <Facebook size={16} aria-hidden="true" />}
            {social.handle}
          </a>
        ))}
        <button
          class="footer-link footer-link--button"
          type="button"
          aria-haspopup="dialog"
          aria-controls="updates-panel"
          aria-expanded="false"
          data-updates-open
        >
          Email updates <ArrowUpRight size={15} aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom page-shell">
    <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
    <p>Wine is better shared.</p>
  </div>
</footer>
