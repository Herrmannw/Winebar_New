---
import { Phone, X } from "lucide-astro";

interface Props {
  endpoint: `https://formspree.io/f/${string}`;
  configured: boolean;
  reservationHref: `tel:${string}`;
}

const { endpoint, configured, reservationHref } = Astro.props;
---

<dialog
  class="updates-panel"
  id="updates-panel"
  aria-labelledby="updates-panel-title"
  aria-describedby="updates-panel-note"
  data-configured={String(configured)}
  data-updates-dialog
>
  <div class="updates-panel__surface" data-updates-surface>
    <button
      class="updates-panel__close"
      type="button"
      aria-label="Close updates panel"
      data-updates-close
    >
      <X size={24} stroke-width={1.4} aria-hidden="true" />
    </button>

    <p class="updates-panel__title" id="updates-panel-title">
      Stay up to date on events, seasonal menus, and exclusive offers.
    </p>

    <form
      class="updates-panel__form"
      action={configured ? endpoint : undefined}
      method="POST"
      aria-busy="false"
      data-updates-form
    >
      <label class="visually-hidden" for="updates-email">Email address</label>
      <div class="updates-panel__form-row">
        <input
          class="updates-panel__input"
          id="updates-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="Email address"
          aria-describedby="updates-panel-note updates-panel-status"
          disabled={!configured}
          required
        />
        <button
          class="button button--ivory updates-panel__submit"
          type="submit"
          disabled={!configured}
        >
          <span data-updates-submit-label>{configured ? "Subscribe" : "Unavailable"}</span>
        </button>
      </div>
      <input
        class="updates-panel__honeypot visually-hidden"
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <input
        type="hidden"
        name="_subject"
        value="New DaVinci’s email-list request"
      />
      <input type="hidden" name="source" value="Website updates panel" />
      <p class="updates-panel__note" id="updates-panel-note">
        {
          configured
            ? "Your email will be sent to DaVinci’s so our team can add you to the updates list."
            : "Email updates are being connected. Please contact DaVinci’s directly in the meantime."
        }
      </p>
      <p
        class="updates-panel__status"
        id="updates-panel-status"
        role="status"
        aria-live="polite"
        data-updates-status
      ></p>
    </form>

    <p
      class="updates-panel__success"
      role="status"
      aria-live="polite"
      tabindex="-1"
      data-updates-success
      hidden
    >
      Thank you—your request has been sent to DaVinci’s. We’ll add you to our
      updates list.
    </p>

    <a
      class="button button--outline-light updates-panel__reserve"
      href={reservationHref}
    >
      <Phone size={18} stroke-width={1.5} aria-hidden="true" />
      Reserve
    </a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-updates-dialog]");
  const surface = dialog?.querySelector<HTMLElement>("[data-updates-surface]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-updates-close]");
  const form = dialog?.querySelector<HTMLFormElement>("[data-updates-form]");
  const emailInput = form?.querySelector<HTMLInputElement>('input[type="email"]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = form?.querySelector<HTMLElement>("[data-updates-submit-label]");
  const status = dialog?.querySelector<HTMLElement>("[data-updates-status]");
  const success = dialog?.querySelector<HTMLElement>("[data-updates-success]");
  const openButtons = Array.from(
    document.querySelectorAll<HTMLElement>("[data-updates-open]"),
  );

  if (dialog && surface && form && emailInput) {
    let openingTrigger: HTMLElement | null = null;
    let returnFocus: HTMLElement | null = null;
    let activeRequest: AbortController | null = null;
    const configured = dialog.dataset.configured === "true";

    const setSubmitting = (submitting: boolean) => {
      form.setAttribute("aria-busy", String(submitting));
      if (submitButton) submitButton.disabled = submitting || !configured;
      if (submitLabel) {
        submitLabel.textContent = submitting
          ? "Sending…"
          : configured
            ? "Subscribe"
            : "Unavailable";
      }
    };

    const resetPanel = () => {
      activeRequest?.abort();
      activeRequest = null;
      form.reset();
      form.hidden = false;
      if (success) success.hidden = true;
      if (status) status.textContent = "";
      setSubmitting(false);
    };

    const setExpanded = (expanded: boolean) => {
      openButtons.forEach((button) => {
        button.setAttribute("aria-controls", dialog.id);
        button.setAttribute("aria-expanded", String(expanded));
      });
    };

    const closeDialog = () => {
      if (dialog.open) dialog.close();
    };

    const openDialog = (trigger: HTMLElement) => {
      openingTrigger = trigger;

      const mobileMenu = document.querySelector<HTMLDialogElement>("#mobile-navigation");
      const mobileMenuTrigger = document.querySelector<HTMLElement>("[data-menu-open]");
      const openedFromMobileMenu = Boolean(trigger.closest("#mobile-navigation"));

      returnFocus = openedFromMobileMenu ? mobileMenuTrigger : trigger;

      if (mobileMenu?.open) mobileMenu.close();
      if (!dialog.open) dialog.showModal();

      setExpanded(true);
      document.documentElement.classList.add("updates-is-open");

      requestAnimationFrame(() => {
        (configured ? emailInput : closeButton)?.focus({ preventScroll: true });
      });
    };

    setExpanded(false);

    openButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        openDialog(button);
      });
    });

    closeButton?.addEventListener("click", closeDialog);

    emailInput.addEventListener("invalid", () => {
      if (status) status.textContent = "Please enter a valid email address.";
    });

    dialog.addEventListener("click", (event) => {
      if (!event.composedPath().includes(surface)) closeDialog();
    });

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDialog();
    });

    dialog.addEventListener("close", () => {
      setExpanded(false);
      document.documentElement.classList.remove("updates-is-open");
      resetPanel();

      const focusTarget = returnFocus ?? openingTrigger;
      if (focusTarget?.isConnected) focusTarget.focus({ preventScroll: true });

      openingTrigger = null;
      returnFocus = null;
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!configured || activeRequest) return;

      if (!form.checkValidity()) {
        if (status) status.textContent = "Please enter a valid email address.";
        form.reportValidity();
        emailInput.focus({ preventScroll: true });
        return;
      }

      if (status) status.textContent = "";
      activeRequest = new AbortController();
      const request = activeRequest;
      setSubmitting(true);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
          signal: request.signal,
        });

        if (response.ok) {
          form.hidden = true;
          if (success) {
            success.hidden = false;
            success.focus({ preventScroll: true });
          }
          return;
        }

        if (status) {
          status.textContent =
            response.status === 429
              ? "Too many requests were sent. Please wait a moment and try again."
              : response.status >= 500
                ? "We couldn’t send your request right now. Please try again shortly."
                : "Your request wasn’t accepted. Please check your email address and try again.";
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        if (status) {
          status.textContent =
            "We couldn’t connect. Check your internet connection and try again.";
        }
      } finally {
        if (activeRequest === request) {
          activeRequest = null;
          setSubmitting(false);
        }
      }
    });
  }
</script>
